<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>net.atlanticbb.tantlinger</groupId>
    <artifactId>shef</artifactId>
    <version>1.0.1</version>
    <description>An HTML Editor widget for JFC/Swing</description>

    <licenses>
        <license>
            <name>GNU Lesser General Public License, version 2.1</name>
            <distribution>repo</distribution>
            <url>https://www.gnu.org/licenses/old-licenses/lgpl-2.1.html</url>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>michelmbem</id>
            <name>Michel Mbem</name>
            <email>michel.mbem@gmail.com</email>
            <roles>
                <role>developer</role>
            </roles>
            <timezone>America/Toronto</timezone>
            <properties>
                <picUrl>https://avatars.githubusercontent.com/u/25884918?v=4</picUrl>
            </properties>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:https://github.com/michelmbem/SHEF.git</connection>
        <developerConnection>scm:git:https://github.com/michelmbem/SHEF.git</developerConnection>
        <url>https://github.com/michelmbem/SHEF</url>
        <tag>HEAD</tag>
    </scm>

    <distributionManagement>
        <snapshotRepository>
            <id>cloudsmith</id>
            <url>https://maven.cloudsmith.io/michelmbem/addy-libraries/</url>
        </snapshotRepository>
        <repository>
            <id>cloudsmith</id>
            <url>https://maven.cloudsmith.io/michelmbem/addy-libraries/</url>
        </repository>
    </distributionManagement>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>11</maven.compiler.release>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.github.jtidy</groupId>
            <artifactId>jtidy</artifactId>
            <version>1.0.5</version>
        </dependency>
        <!-- À installer manuellement dans le depôt maven local -->
        <dependency>
            <groupId>novaworx</groupId>
            <artifactId>novaworx-syntax</artifactId>
            <version>0.0.7</version>
        </dependency>
        <dependency>
            <groupId>sam</groupId>
            <artifactId>sam</artifactId>
            <version>1.0</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Se chargera de déployer automatiquement le contenu du répertoire lib dans le depôt maven local -->
            <!-- N.B.: Invoquer le goal initialize avant le premier build -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-install-plugin</artifactId>
                <version>3.1.1</version>
                <executions>
                    <execution>
                        <id>install-novaworx-syntax-to-local-maven-repo</id>
                        <phase>initialize</phase>
                        <configuration>
                            <file>${project.basedir}/lib/novaworx-syntax-0.0.7.jar</file>
                            <groupId>novaworx</groupId>
                            <artifactId>novaworx-syntax</artifactId>
                            <version>0.0.7</version>
                            <packaging>jar</packaging>
                            <generatePom>true</generatePom>
                        </configuration>
                        <goals>
                            <goal>install-file</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>install-sam-to-local-maven-repo</id>
                        <phase>initialize</phase>
                        <configuration>
                            <file>${project.basedir}/lib/sam.jar</file>
                            <groupId>sam</groupId>
                            <artifactId>sam</artifactId>
                            <version>1.0</version>
                            <packaging>jar</packaging>
                            <generatePom>true</generatePom>
                        </configuration>
                        <goals>
                            <goal>install-file</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-assembly-plugin</artifactId>
                <version>3.5.0</version>
                <configuration>
                    <descriptorRefs>
                        <descriptorRef>jar-with-dependencies</descriptorRef>
                    </descriptorRefs>
                    <archive>
                        <manifest>
                            <mainClass>net.atlanticbb.tantlinger.shef.Demo</mainClass>
                        </manifest>
                    </archive>
                </configuration>
                <executions>
                    <execution>
                        <id>make-assembly</id>
                        <phase>package</phase>
                        <goals>
                            <goal>single</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>